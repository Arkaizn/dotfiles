// Generated by the Quickshell settings app (modules/settings) — edits here
// get overwritten. Included last by config.kdl, so these values win over
// the rest of the config. Change them in the app, or remove the include
// line from config.kdl to drop all of them.


// the settings window itself
window-rule {
    match title="^Quickshell Settings$"
    open-floating true
    default-column-width { fixed 980; }
    default-window-height { fixed 680; }
    geometry-corner-radius 30
    clip-to-geometry true
    draw-border-with-background false
    background-effect { blur true; }
}

binds {
    Mod+S hotkey-overlay-title="Settings" { spawn-sh "qs ipc call settings toggle"; }
}
