[Desktop Entry]
Type=Application
Name=Calendar
GenericName=Calendar
Comment=iCloud, CalDAV, Google / Outlook and local calendars
Icon=x-office-calendar
Exec=sh -c 'if [ -n "$1" ]; then qs ipc call calendar importFile "$1"; else qs ipc call calendar open; fi' sh %f
MimeType=text/calendar;application/ics;
Terminal=false
Categories=Office;Calendar;
Keywords=calendar;events;icloud;caldav;agenda;schedule;ics;import;
StartupNotify=false
